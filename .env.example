F5_BASE_URL=https://us1.calypsoai.app
F5_TOKEN=
F5_PROJECT=
F5_TIMEOUT=30
F5_CONCURRENCY=5
# Connect failures and read-only requests can be retried safely.
F5_RETRIES=2
# Explicit opt-in: scan POST retries can create duplicate scans / charges.
F5_RETRY_SCAN_RESPONSES=false
F5_FLAG_ONLY=false
F5_RESULT_DIR=results
F5_PERSIST=false
GRADIO_ANALYTICS_ENABLED=False
